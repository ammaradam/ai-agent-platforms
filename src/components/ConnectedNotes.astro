---
// A small map at the end of a post: this note in the middle, the notes it links with around it.
import { neighbours, noteGraph } from '@/lib/graph';
import { themeColor } from '@/data/themes';
import type { Post } from '@/lib/posts';
interface Props { posts: Post[]; post: Post; class?: string }
const { posts, post, class: cls = '' } = Astro.props;
const g = noteGraph(posts);
const at = Object.fromEntries(g.nodes.map(n => [n.id, n]));
const me = at[post.id];
const ids = neighbours(g, post.id);
const W = 640, H = 250, cx = W / 2, cy = 118;
const ring = ids.map((id, i) => {
  const a = -Math.PI / 2 + (i + 0.5) * (2 * Math.PI) / ids.length;
  const x = cx + 230 * Math.cos(a), y = cy + 82 * Math.sin(a);
  const e = g.edges.find(e => (e.a === id && e.b === post.id) || (e.b === id && e.a === post.id))!;
  return { n: at[id], x, y, below: y >= cy, mutual: e.mutual };
});
---
{me && ids.length > 0 && (
  <section class:list={[cls]} aria-labelledby="conn-h">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="conn-h" class="text-[1.4rem] font-semibold tracking-[-0.02em]">Connected notes</h2>
      <a href="/notes?view=map" class="hidden shrink-0 text-sm text-muted-foreground hover:text-foreground md:inline">See the full map &rsaquo;</a>
    </div>
    <div class="mt-4 overflow-hidden rounded-2xl border">
      <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full" role="group" aria-label={`Notes connected to ${me.title}`}>
        {ring.map(r => (
          <line x1={cx} y1={cy} x2={r.x} y2={r.y} class="text-border" stroke="currentColor" stroke-width={r.mutual ? 2 : 1.3} stroke-dasharray={r.mutual ? undefined : '5 4'} />
        ))}
        {ring.map(r => (
          <a href={`/posts/${r.n.id}`} class="group" aria-label={r.n.title}>
            <circle cx={r.x} cy={r.y} r="22" fill="transparent" />
            <circle class="cn-dot" cx={r.x} cy={r.y} r="8" style={`fill:${themeColor(r.n.theme)}`} class="stroke-background" stroke-width="3" />
            <text x={r.x} y={r.below ? r.y + 28 : r.y - 17} text-anchor="middle" class="cn-label fill-foreground text-[15px] group-hover:fill-brand" style="paint-order:stroke;stroke:hsl(var(--background));stroke-width:6px;stroke-linejoin:round">{r.n.label}</text>
          </a>
        ))}
        <circle cx={cx} cy={cy} r="13" style={`fill:${themeColor(me.theme)}`} stroke="hsl(var(--brand))" stroke-width="3" />
        <text x={cx} y={cy + 36} text-anchor="middle" class="cn-me fill-muted-foreground text-[13px] font-medium">This note</text>
      </svg>
    </div>
  </section>
)}

<style>
  /* The mini-map is drawn 640 wide; on a phone it shrinks to about half, so labels and dots grow to compensate. */
  @media (max-width: 767px) {
    .cn-label { font-size: 26px; }
    .cn-me { font-size: 22px; }
    .cn-dot { r: 13px; }
  }
</style>
