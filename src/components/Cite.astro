---
interface Props { title: string; date: Date; id: string; class?: string }
const { title, date, id, class: cls = '' } = Astro.props;
const url = new URL(`/posts/${id}/`, Astro.site).href;
const host = new URL(url).hostname;
const month = date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const year = date.getUTCFullYear();
const sentence = /[.?!]$/.test(title) ? title : `${title}.`;
const apa = `Adam, Ammar. (${month} ${year}). ${sentence} ${host}. ${url}.`;
const bib = `@article{adam${year}${id.replace(/[^a-z0-9]/gi, '')},
  title   = {${title}},
  author  = {Adam, Ammar},
  journal = {${host}},
  year    = {${year}},
  month   = {${month}},
  url     = {${url}}
}`;
---
<section class:list={['cite', cls]} aria-labelledby="cite-h">
  <h2 id="cite-h" class="text-[1.4rem] font-semibold tracking-[-0.02em]">Cite this post</h2>
  <blockquote class="mt-3 border-l-2 border-border pl-4 text-[15px] text-muted-foreground leading-relaxed">{apa}</blockquote>
  <details class="mt-3">
  <summary class="cursor-pointer text-sm text-muted-foreground hover:text-foreground">BibTeX</summary>
  <div class="relative mt-2">
    <pre class="overflow-x-auto rounded-2xl bg-muted p-4 font-mono text-[12.5px] leading-relaxed" data-bib>{bib}</pre>
    <button type="button" data-copy-bib class="absolute right-3 top-3 rounded-full bg-background px-3 py-1 text-xs font-medium hover:bg-accent">Copy</button>
  </div>
  </details>
  <span class="sr-only" role="status" aria-live="polite" data-status></span>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.cite').forEach(box => {
    const btn = box.querySelector<HTMLButtonElement>('[data-copy-bib]')!;
    const text = box.querySelector<HTMLElement>('[data-bib]')!.textContent ?? '';
    const status = box.querySelector<HTMLElement>('[data-status]')!;
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(text); btn.textContent = 'Copied'; status.textContent = 'BibTeX copied'; }
      catch { window.prompt('Copy this BibTeX', text); return; }
      setTimeout(() => { btn.textContent = 'Copy'; status.textContent = ''; }, 2000);
    });
  });
</script>
