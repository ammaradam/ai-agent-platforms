---
import { THEMES, themeColor } from '@/data/themes';
import type { Post } from '@/lib/posts';
interface Props { posts: Post[]; class?: string }
const { posts, class: cls = '' } = Astro.props;
---
{posts.length > 0 && (
  <section class:list={[cls]} aria-labelledby="next-h">
    <h2 id="next-h" class="text-[1.4rem] font-semibold tracking-[-0.02em]">Read next</h2>
    <div class="-mx-4 mt-4 flex snap-x snap-mandatory scroll-px-4 gap-2.5 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-5 sm:overflow-visible sm:px-0 sm:pb-0 [&::-webkit-scrollbar]:hidden">
      {posts.map(p => (
        <a href={`/posts/${p.id}`} class="group flex w-[42%] shrink-0 snap-start flex-col overflow-hidden rounded-xl border transition-colors hover:bg-muted/60 sm:w-auto sm:min-w-0" title={THEMES[p.data.themes[0]].name}>
          <img src={`/posts/thumb/${p.id}.jpg`} alt="" width="480" height="270" loading="lazy" class="aspect-video w-full object-cover" />
          <div class="flex gap-1.5 p-2.5">
            <span class="mt-[0.4rem] h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${themeColor(p.data.themes[0])}`} aria-hidden="true"></span>
            <h3 class="line-clamp-3 text-[13px] font-medium leading-snug group-hover:text-brand">{p.data.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
