---
import { THEMES, themeColor, type ThemeKey } from '@/data/themes';
interface Props { counts: Record<string, number> }
const { counts } = Astro.props;
const nodes: [ThemeKey, number, number, number][] = [
  ['ai-platform-engineering', 168, 48, 204], ['identity-security', 168, 110, 204], ['observability', 168, 172, 204],
  ['developer-experience', 168, 234, 204], ['ai-agents', 414, 52, 138], ['reliability', 414, 248, 138],
];
---
<figure class="m-0">
  <div class="rounded-3xl bg-muted p-4 sm:p-5">
    <svg viewBox="0 0 560 330" role="img" aria-label="Map of the topics: requests go from an application or agent, through a shared platform, to models and tools. Each topic links to its posts." class="block h-auto w-full">
      <defs><marker id="tm-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" style="fill:currentColor" /></marker></defs>
      <g style="color:hsl(var(--muted-foreground))">
        <rect x="8" y="132" width="118" height="66" rx="10" style="fill:hsl(var(--muted));stroke:hsl(var(--border))" />
        <text x="67" y="158" text-anchor="middle" font-size="12.5" font-weight="600" style="fill:hsl(var(--foreground))">Application</text>
        <text x="67" y="176" text-anchor="middle" font-size="12.5" font-weight="600" style="fill:hsl(var(--foreground))">or agent</text>
        <line x1="126" y1="165" x2="150" y2="165" style="stroke:currentColor;stroke-width:1.4" marker-end="url(#tm-a)" />
        <rect x="152" y="10" width="236" height="310" rx="14" style="fill:none;stroke:hsl(var(--border));stroke-dasharray:5 5" />
        <text x="168" y="32" font-size="11.5" font-weight="600" style="fill:currentColor">Shared platform</text>
        <line x1="388" y1="165" x2="412" y2="165" style="stroke:currentColor;stroke-width:1.4" marker-end="url(#tm-a)" />
        <rect x="414" y="132" width="138" height="66" rx="10" style="fill:hsl(var(--muted));stroke:hsl(var(--border))" />
        <text x="483" y="158" text-anchor="middle" font-size="12.5" font-weight="600" style="fill:hsl(var(--foreground))">Models</text>
        <text x="483" y="176" text-anchor="middle" font-size="12.5" font-weight="600" style="fill:hsl(var(--foreground))">and tools</text>
        <text x="414" y="40" font-size="11.5" font-weight="600" style="fill:currentColor">Calling tools</text>
        <text x="414" y="236" font-size="11.5" font-weight="600" style="fill:currentColor">When calls fail</text>
      </g>
      {nodes.map(([k, x, y, w]) => (
        <a href={`/themes/${k}`} class="topic-node">
          <rect x={x} y={y} width={w} height="40" rx="9" />
          <circle cx={x + 16} cy={y + 20} r="4.5" style={`fill:${themeColor(k)}`} />
          <text x={x + 28} y={y + 21} dominant-baseline="middle" font-size="12.5" font-weight="500">{THEMES[k].name}</text>
          <text x={x + w - 12} y={y + 21} dominant-baseline="middle" text-anchor="end" font-size="11.5" class="tn-count">{counts[k] ?? 0}</text>
        </a>
      ))}
    </svg>
  </div>
  <figcaption class="mt-2 text-xs text-muted-foreground">Where each topic sits on a request's path. Select a topic to see its posts.</figcaption>
</figure>
