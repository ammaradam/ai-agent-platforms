---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Social from '@/components/Social.astro';
import { PROJECTS } from '@/data/projects';
const built = PROJECTS.slice(0, 4);
const FOCUS = ['MLOps', 'Model deployment', 'AI platforms', 'AI agents', 'Computer vision', 'Retrieval-augmented generation'];
---
<Base title="About" nav="/about" description="About Ammar Adam, a machine learning engineer in Kuala Lumpur focused on MLOps, AI platforms and agents.">
  <div class="max-w-2xl py-10 md:py-14">
    <PageHeader eyebrow="About" title="Hi, I'm Ammar." />
    <div class="mt-6 flex flex-col gap-4 text-[1.1rem] leading-relaxed">
      <p>I'm a machine learning engineer in Kuala Lumpur, Malaysia, with a focus on MLOps: getting models out of notebooks and into services that people can rely on.</p>
      <p class="text-muted-foreground">That means standard pipelines, monitoring, and deployment that scales. Lately my attention is on AI platforms and agents: how they call tools safely, who they act for, and how you can tell when they quietly go wrong. I write about it here, and I build small open-source tools and live demos to test the ideas.</p>
    </div>

    <dl class="mt-8 grid max-w-xl grid-cols-[6.5rem_minmax(0,1fr)] gap-x-5 gap-y-3 text-[15px] leading-snug">
      <dt class="text-muted-foreground">Based in</dt><dd>Kuala Lumpur, Malaysia</dd>
      <dt class="text-muted-foreground">What I do</dt><dd>Machine learning engineer, focused on MLOps and model deployment</dd>
      <dt class="text-muted-foreground">Working on</dt><dd>AI platforms and agents: tool calls, identity, observability and reliability</dd>
      <dt class="text-muted-foreground">Building since</dt><dd>2017, in public on GitHub</dd>
    </dl>

    <h2 class="mt-10 text-[1.15rem] font-semibold tracking-tight">Focus</h2>
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Focus areas">
      {FOCUS.map(f => <li class="rounded-full bg-muted px-3.5 py-1.5 text-sm">{f}</li>)}
    </ul>

    <h2 class="mt-10 text-[1.15rem] font-semibold tracking-tight">A few things I've built</h2>
    <ul class="mt-3 flex flex-col divide-y">
      {built.map(p => (
        <li>
          <a href={p.demo ?? p.repo} class="group flex flex-col gap-0.5 py-3 sm:flex-row sm:items-baseline sm:gap-4">
            <span class="font-mono text-[14px] font-medium group-hover:text-brand sm:w-56 sm:shrink-0">{p.name}</span>
            <span class="text-sm leading-snug text-muted-foreground">{p.tagline}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">I've been building in public on GitHub since 2017: computer vision and NLP experiments, deployment pipelines on Azure and GitHub Actions, and MLOps and RAG toolkits. <a href="/projects" class="text-brand hover:underline">All projects &rsaquo;</a></p>

    <Social class="mt-8" />
  </div>
</Base>
