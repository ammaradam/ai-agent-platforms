---
import Base from '@/layouts/Base.astro';
import { getPosts, themeCounts, usedThemes } from '@/lib/posts';
import { THEMES, themeColor } from '@/data/themes';
const posts = await getPosts();
const counts = themeCounts(posts);
---
<Base title="About" nav="/about" description="About Ammar Adam and this site.">
  <div class="grid gap-10 py-10 md:py-12 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
    <div class="max-w-2xl">
      <p class="eyebrow">Kuala Lumpur</p>
      <h1 class="mt-3 text-4xl font-bold tracking-[-0.035em] sm:text-5xl">About</h1>
      <div class="mt-6 flex flex-col gap-4 font-serif text-[1.2rem] leading-relaxed">
        <p>I'm Ammar Adam, an engineer in Kuala Lumpur. I write about ML systems, AI platforms and the engineering around them.</p>
        <p class="text-muted-foreground">This site is where I compile what I learn. Each post starts as a short note on LinkedIn and gets its full version here, with diagrams, tables and the public sources behind it.</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://github.com/ammaradam" class="inline-flex h-9 items-center rounded-md border border-input bg-background px-4 text-sm font-medium shadow-sm hover:bg-mark/40">GitHub</a>
        <a href="https://www.linkedin.com/in/ammaradam/" class="inline-flex h-9 items-center rounded-md border border-input bg-background px-4 text-sm font-medium shadow-sm hover:bg-mark/40">LinkedIn</a>
        <a href="/rss.xml" class="inline-flex h-9 items-center rounded-md border border-input bg-background px-4 text-sm font-medium shadow-sm hover:bg-mark/40">RSS feed</a>
      </div>
    </div>
    <div class="rounded-lg border bg-card p-5">
      <p class="eyebrow">What I write about</p>
      <ul class="mt-3 flex flex-col gap-1">
        {usedThemes(posts).map(k => <li><a href={`/themes/${k}`} class="flex items-center gap-2.5 rounded-md px-2 py-1.5 text-sm hover:bg-muted"><span class="h-2 w-2 rounded-full" style={`background:${themeColor(k)}`}></span>{THEMES[k].name}<span class="ml-auto font-mono text-xs text-muted-foreground tnum">{counts[k]}</span></a></li>)}
      </ul>
      <p class="mt-4 text-sm text-muted-foreground">New posts on Tuesdays and Thursdays.</p>
    </div>
  </div>
</Base>
