---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { PROJECTS } from '@/data/projects';
const featured = PROJECTS.filter(p => p.featured);
const earlier = PROJECTS.filter(p => !p.featured);
---
<Base title="Projects" nav="/projects" description="Open-source tools by Ammar Adam for running ML and AI agents in production, with live demos you can try in the browser.">
  <div class="py-10 md:py-12">
    <PageHeader title="Projects" lede="Open-source work, mostly on the path from a trained model to a service someone can rely on." />

    <div class="mt-10 flex flex-col gap-6">
      {featured.map(p => (
        <article class="rounded-2xl border p-6">
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="font-mono text-lg font-medium">{p.name}</h2>
            <span class="rounded-full border px-2 py-0.5 text-[12px] text-muted-foreground">{p.status}</span>
            <span class="ml-auto flex gap-2">{p.demo && <a href={p.demo} class="inline-flex h-8 items-center rounded-full bg-primary px-4 text-xs font-medium text-primary-foreground hover:bg-primary/90">Try it live</a>}<a href={p.repo} class='inline-flex h-8 items-center rounded-full border border-input bg-background hover:bg-accent px-4 text-xs font-medium'>View on GitHub</a></span>
          </div>
          <p class="mt-3 text-xl font-semibold leading-snug tracking-tight">{p.tagline}</p>
          <div class="mt-4 grid gap-6 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
            <p class="text-[16px] leading-relaxed text-muted-foreground">{p.summary}</p>
            {p.highlights.length > 0 && (
              <ul class="flex flex-col gap-2 text-sm">
                {p.highlights.map(h => <li class="flex gap-2.5"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span><span>{h}</span></li>)}
              </ul>
            )}
          </div>
          <div class="mt-5 flex flex-wrap gap-1.5">{p.stack.map(s => <span class="rounded-full bg-muted px-2.5 py-0.5 text-[12px] text-muted-foreground">{s}</span>)}</div>
        </article>
      ))}
    </div>

    <h2 class="mt-14 text-[1.4rem] font-semibold tracking-[-0.02em]">Earlier experiments</h2>
    <div class="mt-3 flex flex-col divide-y border-t">
      {earlier.map((p, i) => (
        <a href={p.repo} class="group grid gap-1 py-3.5 sm:grid-cols-[14rem_minmax(0,1fr)_auto] sm:items-center sm:gap-6">
          <span class="font-mono text-sm font-medium group-hover:text-brand">{p.name}</span>
          <span class="text-sm text-muted-foreground">{p.tagline}</span>
          <span class="text-xs text-muted-foreground">{p.status}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
