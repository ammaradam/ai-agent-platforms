---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getPosts, themePosts, usedThemes } from '@/lib/posts';
import { THEMES, themeColor, themeVar } from '@/data/themes';
import { fmtDate } from '@/lib/utils';
const posts = await getPosts();
const themes = usedThemes(posts);
---
<Base title="Topics" nav="/notes" description="Posts grouped by topic, oldest first so each topic reads as a series.">
  <div class="py-10 md:py-12">
    <PageHeader eyebrow="Notes" href="/notes" title="Topics" lede="Posts grouped by topic, oldest first so each topic reads as a series. A post can sit in more than one topic." />
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {themes.map(k => {
        const list = themePosts(posts, k);
        return (
          <a href={`/themes/${k}`} class="group flex flex-col rounded-2xl border p-6 transition-colors hover:bg-muted/60" style={themeVar(k)}>
            <div class="flex items-baseline gap-2.5"><h2 class="kicker">{THEMES[k].name}</h2><span class="ml-auto text-xs text-muted-foreground tnum">{list.length} {list.length === 1 ? 'post' : 'posts'}</span></div>
            <p class="mt-2 text-[19px] font-medium leading-snug tracking-[-0.01em] group-hover:text-brand">{THEMES[k].blurb}</p>
            <p class="mt-auto pt-4 text-[12px] text-muted-foreground tnum">Latest: {list[list.length - 1].data.title}, {fmtDate(list[list.length - 1].data.date)}</p>
          </a>
        );
      })}
    </div>
  </div>
</Base>
