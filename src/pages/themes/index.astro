---
import Base from '@/layouts/Base.astro';
import { getPosts, themePosts, usedThemes } from '@/lib/posts';
import { THEMES, themeColor } from '@/data/themes';
import { fmtDate } from '@/lib/utils';
const posts = await getPosts();
const themes = usedThemes(posts);
---
<Base title="Themes" nav="/themes" description="Posts grouped by topic, oldest first so each theme reads as a series.">
  <div class="py-10 md:py-12">
    <p class="eyebrow">{themes.length} topics</p>
    <h1 class="mt-3 text-4xl font-bold tracking-[-0.035em] sm:text-5xl">Themes</h1>
    <p class="mt-2 max-w-2xl font-serif text-[1.1rem] leading-relaxed text-muted-foreground">Posts grouped by topic, oldest first so each theme reads as a series. A post can sit in more than one theme.</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {themes.map(k => {
        const list = themePosts(posts, k);
        return (
          <a href={`/themes/${k}`} class="group flex flex-col rounded-lg border bg-card p-5 transition-colors hover:border-foreground/30 hover:bg-mark/20">
            <div class="flex items-center gap-2.5"><span class="h-3 w-3 rounded-full" style={`background:${themeColor(k)}`}></span><h2 class="text-xl font-bold tracking-tight group-hover:text-brand">{THEMES[k].name}</h2><span class="ml-auto font-mono text-xs text-muted-foreground tnum">{list.length} {list.length === 1 ? 'post' : 'posts'}</span></div>
            <p class="mt-2 font-serif text-[15.5px] leading-relaxed text-muted-foreground">{THEMES[k].blurb}</p>
            <div class="mt-4 flex gap-1" aria-hidden="true">{list.map(() => <span class="h-4 w-1.5 rounded-sm" style={`background:${themeColor(k)}`}></span>)}</div>
            <p class="mt-2 font-mono text-[11px] text-muted-foreground tnum">Latest: {list[list.length - 1].data.title}, {fmtDate(list[list.length - 1].data.date)}</p>
          </a>
        );
      })}
    </div>
  </div>
</Base>
