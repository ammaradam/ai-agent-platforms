---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found">
  <div class="py-24 text-center">
    <h1 class="text-3xl font-semibold tracking-tight">This page doesn't exist</h1>
    <p class="mt-3 text-muted-foreground">The link may be old. Try the list of insights or search with ⌘K.</p>
    <a href="/insights" class="mt-6 inline-flex h-10 items-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground">Browse all insights</a>
  </div>
</Base>
