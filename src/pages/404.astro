---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found">
  <div class="py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em]">This page doesn't exist</h1>
    <p class="mt-3 text-lg text-muted-foreground">The link may be old. Try the list of insights or search with ⌘K.</p>
    <a href="/insights" class="mt-6 inline-flex h-10 items-center rounded-full bg-primary px-6 text-sm font-medium text-primary-foreground">Browse all insights</a>
  </div>
</Base>
