---
import Base from '@/layouts/Base.astro';
import { getPosts, themeCounts, usedThemes } from '@/lib/posts';
import { THEMES, themeColor, themeVar } from '@/data/themes';
import { PROJECTS } from '@/data/projects';
import { fmtDate } from '@/lib/utils';
const posts = await getPosts();
const counts = themeCounts(posts);

// A short list of posts that show how I think about running AI in production.
const START_HERE = ['tool-call-timeouts', 'agent-identity-is-not-authorization', 'agent-success-is-not-a-200'];
const start = START_HERE.map(id => posts.find(p => p.id === id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const latest = posts.slice(0, 3);
const featured = PROJECTS.filter(p => p.featured).slice(0, 3);
const link = 'font-medium text-brand hover:underline';
const seeAll = 'shrink-0 text-sm text-muted-foreground hover:text-foreground';
---
<Base nav="/">
  <script is:inline>
    try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) document.documentElement.classList.add('reveal-on'); } catch (e) {}
  </script>
  <section class="pt-8 md:pt-14">
    <h1 class="max-w-3xl text-[2.15rem] font-semibold leading-[1.1] tracking-[-0.022em] sm:text-5xl">Hi, I'm Ammar Adam, an engineer in Kuala Lumpur.</h1>
    <p class="mt-4 max-w-2xl text-[1.1rem] leading-relaxed text-muted-foreground sm:text-[1.2rem]">I write about running ML systems, AI platforms and agents in production, and build open-source tools to test the ideas. Here you will find:</p>
    <ul class="mt-4 flex max-w-2xl list-disc flex-col gap-2.5 pl-5 text-[1.05rem] leading-relaxed marker:text-muted-foreground">
      <li><a href="/notes" class={link}>Notes</a> on agent tools, identity, observability and reliability, each backed by a diagram and its public sources.</li>
      <li><a href="/projects" class={link}>Projects</a> such as mlops-toolbox and the Agent Gateway Playground, with live demos you can try in the browser.</li>
      <li><a href="/about" class={link}>About me</a>: my work and what I am building next.</li>
    </ul>
  </section>

  <!-- Notes: a peek at the newest and a few to start with -->
  <section data-reveal class="mt-12 border-t pt-8" aria-labelledby="notes-h">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="notes-h" class="text-[1.4rem] font-semibold tracking-[-0.02em]">Notes</h2>
      <a href="/notes" class={seeAll}>All {posts.length} posts &rsaquo;</a>
    </div>
    <div class="mt-4 grid gap-x-10 gap-y-6 md:grid-cols-2">
      <div>
        <h3 class="eyebrow">Latest</h3>
        <ul class="mt-1 flex flex-col divide-y">
          {latest.map(p => (
            <li><a href={`/posts/${p.id}`} class="group flex gap-4 py-2.5"><time class="w-12 shrink-0 pt-px text-xs text-muted-foreground tnum" datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, { day: 'numeric', month: 'short' })}</time><span class="text-[15px] font-medium leading-snug group-hover:text-brand">{p.data.title}</span></a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="eyebrow">Start here</h3>
        <ul class="mt-1 flex flex-col divide-y">
          {start.map(p => (
            <li><a href={`/posts/${p.id}`} class="group flex items-baseline gap-3 py-2.5"><span class="text-[15px] font-medium leading-snug group-hover:text-brand">{p.data.title}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Projects: a peek, one line each -->
  <section data-reveal class="mt-10 border-t pt-8" aria-labelledby="projects-h">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="projects-h" class="text-[1.4rem] font-semibold tracking-[-0.02em]">Projects</h2>
      <a href="/projects" class={seeAll}>All projects &rsaquo;</a>
    </div>
    <ul class="mt-3 flex flex-col divide-y">
      {featured.map(p => (
        <li class="flex items-center justify-between gap-4 py-3">
          <a href={p.repo} class="group min-w-0">
            <span class="block font-mono text-[14px] font-medium group-hover:text-brand">{p.name}</span>
            <span class="mt-0.5 block text-sm leading-snug text-muted-foreground">{p.tagline}</span>
          </a>
          {p.demo
            ? <a href={p.demo} class="shrink-0 rounded-full bg-primary px-3.5 py-1.5 text-xs font-medium text-primary-foreground hover:bg-primary/90">Try it live</a>
            : <a href={p.repo} class="shrink-0 rounded-full border border-input bg-background hover:bg-accent px-3.5 py-1.5 text-xs font-medium">GitHub</a>}
        </li>
      ))}
    </ul>
  </section>

  <!-- Topics: a peek, as chips -->
  <section data-reveal class="mt-10 border-t pt-8" aria-labelledby="topics-h">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="topics-h" class="text-[1.4rem] font-semibold tracking-[-0.02em]">Topics</h2>
      <a href="/themes" class={seeAll}>All topics &rsaquo;</a>
    </div>
    <ul class="mt-4 flex flex-wrap gap-x-7 gap-y-3">
      {usedThemes(posts).map(k => (
        <li><a href={`/themes/${k}`} class="kicker text-[13px]" style={themeVar(k)}>{THEMES[k].name}<span class="ml-1.5 font-medium text-muted-foreground">{counts[k]}</span></a></li>
      ))}
    </ul>
  </section>
</Base>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('reveal-on')) return;
    var secs = document.querySelectorAll('[data-reveal]');
    secs.forEach(function (sec) {
      var parts = [sec.firstElementChild].concat([].slice.call(sec.querySelectorAll('h3, li')));
      parts.forEach(function (el, i) { el.classList.add('rv'); el.style.setProperty('--i', Math.min(i, 8)); });
    });
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -12% 0px' });
    secs.forEach(function (sec) { io.observe(sec); });
  })();
</script>
