---
import Base from '@/layouts/Base.astro';
import PostRow from '@/components/PostRow.astro';
import TopicMap from '@/components/TopicMap.astro';
import { getPosts, themeCounts, themePosts, usedThemes } from '@/lib/posts';
import { THEMES, themeColor } from '@/data/themes';
import { PROJECTS } from '@/data/projects';
const posts = await getPosts();
const counts = themeCounts(posts);
const themes = usedThemes(posts);
const featured = PROJECTS.filter(p => p.featured);
---
<Base nav="/">
  <section class="grid items-center gap-10 py-12 md:py-16 lg:grid-cols-[minmax(0,.95fr)_minmax(0,1.05fr)] lg:gap-12">
    <div>
      <p class="text-sm font-medium text-muted-foreground">{posts.length} insights, new on Tuesdays and Thursdays</p>
      <h1 class="mt-3 text-[2.4rem] font-semibold leading-[1.06] tracking-[-0.035em] sm:text-5xl lg:text-[3.2rem]">Notes on AI platforms, agents and the systems around them</h1>
      <p class="mt-5 max-w-[34rem] text-[17px] leading-relaxed text-muted-foreground">I'm Ammar, an engineer in Kuala Lumpur. Each of my LinkedIn posts gets a longer version here, with diagrams, tables and the public sources behind it.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/insights" class="inline-flex h-10 items-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">Browse all insights</a>
        <a href={`/posts/${posts[0].id}`} class="inline-flex h-10 items-center rounded-md border border-input bg-background px-6 text-sm font-medium shadow-sm hover:bg-accent">Read the latest</a>
      </div>
    </div>
    <div class="hidden md:block"><TopicMap counts={counts} /></div>
    <div class="md:hidden">
      <p class="text-sm font-medium">Jump to a theme</p>
      <div class="mt-3 grid grid-cols-2 gap-2">
        {themes.map(k => (
          <a href={`/themes/${k}`} class="flex items-center gap-2 rounded-lg border bg-card px-3 py-2.5 text-sm">
            <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${themeColor(k)}`}></span><span class="min-w-0 truncate">{THEMES[k].name}</span><span class="ml-auto text-xs text-muted-foreground tnum">{counts[k]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t py-12">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-xl font-semibold tracking-tight">Latest</h2>
      <a href="/insights" class="text-sm text-muted-foreground hover:text-foreground">All {posts.length} insights</a>
    </div>
    <div class="mt-3 flex flex-col">{posts.slice(0, 3).map(p => <PostRow post={p} />)}</div>
  </section>

  <section class="border-t py-12">
    <h2 class="text-xl font-semibold tracking-tight">Browse by theme</h2>
    <p class="mt-1 text-sm text-muted-foreground">Posts in each theme, oldest first, so they read as a series.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {themes.map(k => {
        const list = themePosts(posts, k);
        return (
          <div class="flex min-w-0 flex-col rounded-lg border bg-card p-5">
            <div class="flex items-center gap-2.5"><span class="h-2.5 w-2.5 rounded-full" style={`background:${themeColor(k)}`}></span><h3 class="font-semibold tracking-tight">{THEMES[k].name}</h3><span class="ml-auto text-xs text-muted-foreground tnum">{list.length} {list.length === 1 ? 'post' : 'posts'}</span></div>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{THEMES[k].blurb}</p>
            <ol class="mt-3 flex flex-col">{list.slice(0, 4).map(p => <li><a href={`/posts/${p.id}`} class="block truncate rounded py-1 text-sm hover:text-brand">{p.data.title}</a></li>)}</ol>
            <a href={`/themes/${k}`} class="mt-auto pt-3 text-sm font-medium text-brand">{list.length > 4 ? `See all ${list.length}` : 'Open theme'}</a>
          </div>
        );
      })}
    </div>
  </section>

  <section class="border-t py-12">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-xl font-semibold tracking-tight">Projects</h2>
      <a href="/projects" class="text-sm text-muted-foreground hover:text-foreground">All projects</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {featured.map(p => (
        <a href={p.repo} class="group flex min-w-0 flex-col rounded-lg border bg-card p-5 transition-colors hover:bg-muted/40">
          <div class="flex items-center justify-between gap-3"><h3 class="font-mono text-[15px] font-medium group-hover:text-brand">{p.name}</h3><span class="rounded-full border px-2 py-0.5 text-xs text-muted-foreground">{p.status}</span></div>
          <p class="mt-2 text-[15px] font-medium leading-snug">{p.tagline}</p>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.summary}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">{p.stack.map(s => <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">{s}</span>)}</div>
        </a>
      ))}
    </div>
  </section>
</Base>
