---
import Base from '@/layouts/Base.astro';
import Newsletter from '@/components/Newsletter.astro';
import { getPosts, themeCounts, usedThemes } from '@/lib/posts';
import { THEMES, themeColor } from '@/data/themes';
import { PROJECTS } from '@/data/projects';
import { fmtDate } from '@/lib/utils';
const posts = await getPosts();
const counts = themeCounts(posts);

// A short list of posts that show how I think about running AI in production.
const START_HERE = ['tool-call-timeouts', 'agent-identity-is-not-authorization', 'agent-success-is-not-a-200'];
const start = START_HERE.map(id => posts.find(p => p.id === id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const latest = posts.slice(0, 3);
const featured = PROJECTS.filter(p => p.featured).slice(0, 3);
const link = 'font-medium text-brand hover:underline';
const seeAll = 'shrink-0 text-sm text-muted-foreground hover:text-foreground';
---
<Base nav="/">
  <section class="pt-8 md:pt-14">
    <h1 class="max-w-3xl text-[2.15rem] font-semibold leading-[1.1] tracking-[-0.035em] sm:text-5xl">Hi, I'm Ammar Adam, an engineer in Kuala Lumpur.</h1>
    <p class="mt-4 max-w-2xl text-[1.1rem] leading-relaxed text-muted-foreground sm:text-[1.2rem]">I write about ML systems, AI platforms and agents, and build open-source tools to go with it. This site is where the writing and the projects live. On it, I:</p>
    <ul class="mt-4 flex max-w-2xl list-disc flex-col gap-2.5 pl-5 text-[1.05rem] leading-relaxed marker:text-muted-foreground">
      <li><a href="/insights" class={link}>Write</a> about running AI in production: agent tools, identity, observability and reliability.</li>
      <li><a href="/projects" class={link}>Build</a> open-source tools, such as mlops-toolbox, with live demos you can try in the browser.</li>
      <li>Back every post with diagrams and the public sources behind it. <a href="/about" class={link}>More about me</a>.</li>
    </ul>
    <Newsletter formOnly class="mt-7" />
  </section>

  <!-- Writing: a peek at the newest and a few to start with -->
  <section class="mt-12 border-t pt-8" aria-labelledby="writing-h">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="writing-h" class="text-[1.4rem] font-semibold tracking-[-0.02em]">Writing</h2>
      <a href="/insights" class={seeAll}>All {posts.length} posts &rsaquo;</a>
    </div>
    <div class="mt-4 grid gap-x-10 gap-y-6 md:grid-cols-2">
      <div>
        <h3 class="eyebrow">Latest</h3>
        <ul class="mt-1 flex flex-col divide-y">
          {latest.map(p => (
            <li><a href={`/posts/${p.id}`} class="group flex gap-4 py-2.5"><time class="w-12 shrink-0 pt-px text-xs text-muted-foreground tnum" datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, { day: 'numeric', month: 'short' })}</time><span class="text-[15px] font-medium leading-snug group-hover:text-brand">{p.data.title}</span></a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="eyebrow">Start here</h3>
        <ul class="mt-1 flex flex-col divide-y">
          {start.map(p => (
            <li><a href={`/posts/${p.id}`} class="group flex items-baseline gap-3 py-2.5"><span class="h-2 w-2 shrink-0 rounded-full" style={`background:${themeColor(p.data.themes[0])}`}></span><span class="text-[15px] font-medium leading-snug group-hover:text-brand">{p.data.title}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Projects: a peek, one line each -->
  <section class="mt-10 border-t pt-8" aria-labelledby="projects-h">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="projects-h" class="text-[1.4rem] font-semibold tracking-[-0.02em]">Projects</h2>
      <a href="/projects" class={seeAll}>All projects &rsaquo;</a>
    </div>
    <ul class="mt-3 flex flex-col divide-y">
      {featured.map(p => (
        <li class="flex items-center justify-between gap-4 py-3">
          <a href={p.repo} class="group min-w-0">
            <span class="block font-mono text-[14px] font-medium group-hover:text-brand">{p.name}</span>
            <span class="mt-0.5 block text-sm leading-snug text-muted-foreground">{p.tagline}</span>
          </a>
          {p.demo
            ? <a href={p.demo} class="shrink-0 rounded-full bg-primary px-3.5 py-1.5 text-xs font-medium text-primary-foreground hover:bg-primary/90">Try it live</a>
            : <a href={p.repo} class="shrink-0 rounded-full border border-input bg-background hover:bg-accent px-3.5 py-1.5 text-xs font-medium">GitHub</a>}
        </li>
      ))}
    </ul>
  </section>

  <!-- Topics: a peek, as chips -->
  <section class="mt-10 border-t pt-8" aria-labelledby="topics-h">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="topics-h" class="text-[1.4rem] font-semibold tracking-[-0.02em]">Topics</h2>
      <a href="/themes" class={seeAll}>All topics &rsaquo;</a>
    </div>
    <ul class="mt-3 flex flex-wrap gap-2">
      {usedThemes(posts).map(k => (
        <li><a href={`/themes/${k}`} class="inline-flex items-center gap-2 rounded-full bg-muted px-3.5 py-1.5 text-sm transition-colors hover:bg-accent"><span class="h-2 w-2 rounded-full" style={`background:${themeColor(k)}`}></span>{THEMES[k].name}<span class="text-xs text-muted-foreground tnum">{counts[k]}</span></a></li>
      ))}
    </ul>
  </section>
</Base>
