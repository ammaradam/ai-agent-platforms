---
import Base from '@/layouts/Base.astro';
import MobilePostNav, { DesktopToc } from '@/components/PostNav';
import { getPosts, headingsOf, minutesOf, recommend, themePosts } from '@/lib/posts';
import { THEMES, themeColor } from '@/data/themes';
import { fmtDate } from '@/lib/utils';
import { render } from 'astro:content';
import Share from '@/components/Share.astro';
import Cite from '@/components/Cite.astro';
import NextReads from '@/components/NextReads.astro';
import Comments from '@/components/Comments.astro';
import ConnectedNotes from '@/components/ConnectedNotes.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(p => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getPosts();
const asc = [...posts].reverse();
const i = asc.findIndex(p => p.id === post.id);
const older = asc[i - 1], newer = asc[i + 1];
const k = post.data.themes[0];
const series = themePosts(posts, k);
const pos = series.findIndex(p => p.id === post.id);
const headings = headingsOf(post);
const nextReads = recommend(posts, post, 5);
const PLAYGROUND: Record<string, string> = { 'tool-call-timeouts': 'timeout', 'agent-identity-is-not-authorization': 'permission', 'agent-success-is-not-a-200': 'wrong200' };
const playground = PLAYGROUND[post.id];
---
<Base title={post.data.title} description={post.data.insight} image={`/posts/${post.id}.jpg`} nav="/notes" type="article" published={post.data.date}>
  <div id="read-bar" aria-hidden="true" class="pointer-events-none fixed left-0 z-50 h-0.5 w-full origin-left scale-x-0" style="top:calc(env(safe-area-inset-top,0px) + 47px);background:hsl(var(--brand))"></div>
  <MobilePostNav client:idle headings={headings} />
  <div class="grid gap-12 py-8 md:py-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <article class="min-w-0">
      <nav class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground" aria-label="Breadcrumb">
        <a href="/notes" class="hover:text-foreground">Notes</a><span>/</span>
        <a href={`/themes/${k}`} class="inline-flex items-center gap-1.5 hover:text-foreground"><span class="h-2 w-2 rounded-full" style={`background:${themeColor(k)}`}></span>{THEMES[k].name}</a>
      </nav>
      <h1 class="mt-4 max-w-3xl text-[2.2rem] font-semibold leading-[1.07] tracking-[-0.022em] sm:text-[3.25rem]">{post.data.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
        <time class="tnum" datetime={post.data.date.toISOString()}>{fmtDate(post.data.date, { day: 'numeric', month: 'long', year: 'numeric' })}</time>
        <span class="tnum">{minutesOf(post)} min read</span>
        <a href="#sources" class="hover:text-foreground">{post.data.sources.length} sources</a>
        {post.data.linkedin && <a href={post.data.linkedin} class="hover:text-foreground">Discuss on LinkedIn &rsaquo;</a>}
        {post.data.themes.slice(1).map(t => <a href={`/themes/${t}`} class="inline-flex items-center gap-1.5 hover:text-foreground"><span class="h-2 w-2 rounded-full" style={`background:${themeColor(t)}`}></span>Also in {THEMES[t].name}</a>)}
      </div>

      <div class="mt-6 max-w-3xl overflow-hidden rounded-3xl bg-muted">
        <img src={`/posts/${post.id}.jpg`} alt="" width="1280" height="720" class="aspect-[2/1] h-auto w-full object-cover" fetchpriority="high" />
      </div>

      <p class="mt-8 max-w-3xl text-[1.15rem] font-medium leading-snug tracking-[-0.015em] sm:text-[1.45rem]" style={`border-left:3px solid ${themeColor(k)}; padding-left:1rem`}>{post.data.insight}</p>

      <div class="prose mt-10"><Content /></div>

      {playground && (
        <aside class="mt-14 max-w-3xl rounded-2xl border p-6">
          <p class="eyebrow">Interactive</p>
          <h2 class="mt-1 text-[1.4rem] font-semibold tracking-[-0.02em]">Break it yourself</h2>
          <p class="mt-2 text-muted-foreground">Run this exact failure in the Agent Gateway Playground. Flip the switches and watch each step as an animated trace.</p>
          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={`https://agent-gateway-playground.vercel.app/?scenario=${playground}`} class="inline-flex h-10 items-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90">Open the playground</a>
            <a href="https://github.com/ammaradam/agent-gateway-playground" class="text-sm text-brand hover:underline">View the code &rsaquo;</a>
          </div>
        </aside>
      )}

      {post.data.caveats.length > 0 && (
        <section class="mt-14 max-w-3xl">
          <h2 class="text-[1.4rem] font-semibold tracking-[-0.02em]">Limitations</h2>
          <div class="mt-4 overflow-hidden rounded-2xl border">
            {post.data.caveats.map((c, j) => (
              <div class:list={['grid gap-1 px-4 py-3.5 sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] sm:gap-6', j && 'border-t']}>
                <p class="text-[15px] font-medium leading-snug">{c.title}</p>
                <p class="text-sm leading-relaxed text-muted-foreground">{c.text}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <section id="sources" class="mt-10 max-w-3xl scroll-mt-24">
        <h2 class="text-[1.4rem] font-semibold tracking-[-0.02em]">Sources</h2>
        <div class="mt-4 flex flex-col divide-y overflow-hidden rounded-2xl border">
          {post.data.sources.map(s => (
            <a href={s.url} class="group flex items-center gap-3 px-4 py-3.5 hover:bg-muted/50">
              <span class="min-w-0"><span class="block text-sm font-medium group-hover:text-brand">{s.title}</span><span class="block text-xs text-muted-foreground">{s.site}</span></span>
            </a>
          ))}
        </div>
      </section>

      <Cite title={post.data.title} date={post.data.date} id={post.id} class="mt-10 max-w-3xl" />

      <aside class="mt-14 flex max-w-3xl items-start gap-4 border-t pt-8" aria-label="About the author">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-muted text-sm font-semibold" aria-hidden="true">AA</span>
        <p class="text-sm leading-relaxed text-muted-foreground"><strong class="font-semibold text-foreground">Written by Ammar Adam</strong>, an engineer in Kuala Lumpur who writes about ML systems, AI platforms and agents. <a href="/about" class="text-brand hover:underline">More about me &rsaquo;</a></p>
      </aside>
      <Share title={post.data.title} class="mt-4 max-w-3xl" />

      <Comments slug={post.id} class="mt-14 max-w-3xl border-t pt-8" />


      <ConnectedNotes posts={posts} post={post} class="mt-16 max-w-3xl" />

      <NextReads posts={nextReads} class="mt-12 max-w-3xl" />
    </article>

    <aside class="hidden lg:block">
      <div class="sticky flex flex-col gap-8" style="top:calc(env(safe-area-inset-top,0px) + 84px)">
        <div>
          <p class="mb-3 text-sm font-medium">On this page</p>
          <DesktopToc client:visible headings={headings} />
        </div>
        <div>
          <p class="flex items-center gap-2 text-sm font-medium"><span class="h-2 w-2 rounded-full" style={`background:${themeColor(k)}`}></span>{THEMES[k].name}</p>
          <p class="mt-0.5 text-xs text-muted-foreground tnum">Post {pos + 1} of {series.length} in this topic</p>
          <ol class="mt-3 flex flex-col">{series.map((x, n) => <li>{x.id === post.id
            ? <span aria-current="page" class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-1 rounded-md bg-muted px-2 py-1.5 text-sm font-medium"><span class="text-muted-foreground tnum">{n + 1}</span>{x.data.title}</span>
            : <a href={`/posts/${x.id}`} class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-1 rounded-md px-2 py-1.5 text-sm text-muted-foreground hover:bg-muted/60 hover:text-foreground"><span class="tnum">{n + 1}</span>{x.data.title}</a>}</li>)}</ol>
        </div>
      </div>
    </aside>
  </div>
</Base>

<script is:inline>
  (function () {
    var bar = document.getElementById('read-bar'), art = document.querySelector('article');
    if (!bar || !art) return;
    function tick() {
      var r = art.getBoundingClientRect(), total = r.height - innerHeight;
      var p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
      bar.style.transform = 'scaleX(' + p + ')';
    }
    addEventListener('scroll', tick, { passive: true }); addEventListener('resize', tick); tick();
  })();
</script>
